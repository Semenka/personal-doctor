# ── Personal Doctor — Environment Configuration ──
# Copy to .env and fill in your values:  cp .env.example .env

# ── Required: API Keys ──
GOOGLE_API_KEY=your-gemini-api-key
OURA_ACCESS_TOKEN=your-oura-token

# ── Required: Email Delivery ──
EMAIL_TO=your-email@gmail.com
SMTP_HOST=smtp.yahoo.com
SMTP_PORT=465
SMTP_USER=your-yahoo-account@yahoo.com
SMTP_PASSWORD=your-yahoo-app-password

# ── Optional: Google Drive ──
# Directory containing credentials.json and token.json from Google Cloud Console
# GDRIVE_CREDENTIALS_DIR=~/.config/personal-doctor/gdrive

# ── Optional: Timezone (default: Europe/Paris) ──
# HEALTH_TIMEZONE=Europe/Paris

# ── Optional: Data storage ──
# HEALTH_DATA_DIR=~/personal-doctor/data
# HEALTH_LOG_DIR=~/personal-doctor/logs

# ── Optional: PostgreSQL (falls back to JSON files) ──
# DATABASE_URL=postgresql://user:pass@localhost:5432/health

# ── Optional: Server ──
# HOST=0.0.0.0
# PORT=8000

# ── Optional: Action tracking (clickable "Mark Done" buttons in email) ──
# Set to your Mac Mini's reachable address so email links work from your phone.
# Use Tailscale (100.x.x.x:8000), local IP (192.168.x.x:8000), or ngrok URL.
# SERVER_URL=http://localhost:8000
